# Required in production. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Public site URL (no trailing slash). Example: https://qr-universe.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (https://console.neon.tech) — paste the connection string.
# Local/VPS can leave this as a placeholder; the app still runs on .data/db.json.
DATABASE_URL="postgresql://user:password@localhost:5432/qr_universe"

# Optional overrides (defaults are already in the product)
NEXT_PUBLIC_CONTACT_PHONE=+905413230002
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+90 541 323 00 02
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/905413230002
