# Required in production. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Public site URL (no trailing slash). Example: https://qruniverse.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres pooled connection string (sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon Object Storage (S3-compatible). Create a bucket named qr-universe or override.
AWS_ENDPOINT_URL_S3="https://YOUR-BRANCH.storage.c-5.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
AWS_REGION="us-east-2"
AWS_S3_BUCKET="qr-universe"

# Tutorial video shown on /guide. Paste any YouTube link (share, watch or
# embed form) — leave empty and the page just shows the written steps.
NEXT_PUBLIC_TUTORIAL_VIDEO_URL=

# Optional overrides (defaults are already in the product)
NEXT_PUBLIC_CONTACT_PHONE=+905413230002
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+90 541 323 00 02
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/905413230002

# Comma-separated emails that can open Admin → Control (ban, change plan, delete workspaces).
# Also who gets the "new signup" email below — everyone in this list, every time someone registers.
PLATFORM_ADMIN_EMAILS=javidalishov700@gmail.com

# Email via Resend (signup verification + forgot password + new-signup alerts to PLATFORM_ADMIN_EMAILS).
# 1) https://resend.com → API Keys → Create
# 2) Paste the re_… key here and in Vercel env (Production + Preview)
# 3) Test from: QR-Universe <beth.t@resend.dev>  (only delivers to your Resend account email)
# 4) For all customers: verify a domain in Resend, then set EMAIL_FROM to that domain
RESEND_API_KEY=
EMAIL_FROM="QR-Universe <beth.t@resend.dev>"

