# Secret used to sign session JWTs (see src/lib/auth/jwt.ts). Falls back to a
# hardcoded development-only secret when unset — set a real value in
# production deployments.
AUTH_SECRET=

# Only used by prisma/schema.prisma for validation/tooling in this project;
# the app itself runs against an in-memory + JSON-persisted mock database
# (see src/lib/data) and does not require a live database connection.
DATABASE_URL="postgresql://user:password@localhost:5432/qr_universe"
