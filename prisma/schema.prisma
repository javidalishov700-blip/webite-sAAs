// QR-Universe — production data model (Neon Postgres via Prisma).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  EDITOR
}

enum Industry {
  RESTAURANT
  GROCERY
  RETAIL
  HOME
  HARDWARE
  EDUCATION
  ELECTRONICS
  TOBACCO
  SERVICES
  OTHER
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  LIST
}

enum QrDotStyle {
  SQUARE
  DOTS
  ROUNDED
  CLASSY
  CLASSY_ROUNDED
  EXTRA_ROUNDED
}

enum Locale {
  en
  ru
  tr
  az
}

enum AbuseReason {
  ILLEGAL
  ADULT
  FRAUD
  HATE
  COPYRIGHT
  OTHER
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  avatarUrl       String?
  /// When the user ticked Terms + prohibited-content rules at signup.
  acceptedTermsAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]

  @@index([email])
}

/// Join table enabling multi-tenant, multi-user companies with per-user roles.
/// Data isolation is enforced everywhere by scoping every query through
/// `companyId`, never by a global table scan.
model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@unique([userId, companyId])
  @@index([companyId])
}

model Company {
  id               String   @id @default(cuid())
  /// Public, unique, URL-safe identifier used for `/c/[slug]` catalog routing.
  slug             String   @unique
  name             String
  description      String?
  logoUrl          String?
  coverUrl         String?
  industry         Industry @default(OTHER)
  plan             Plan     @default(FREE)
  currency         String   @default("USD")
  defaultLocale    Locale   @default(en)
  supportedLocales Locale[] @default([en])
  accentColor      String   @default("#7C5CFF")
  address          String?
  phone            String?
  website          String?
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships   Membership[]
  categories    Category[]
  items         Item[]
  qrCodes       QrCode[]
  scanEvents    ScanEvent[]
  itemViews     ItemView[]
  abuseReports  AbuseReport[]

  @@index([slug])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  position  Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  items Item[]

  @@index([companyId, position])
}

model Item {
  id             String   @id @default(cuid())
  title          String
  description    String?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  currency       String   @default("USD")
  images         String[] @default([])
  isVisible      Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  stockCount     Int?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String

  attributes ItemAttribute[]
  views      ItemView[]

  @@index([companyId, categoryId, position])
}

/// Dynamic, industry-agnostic key/value attributes attached to an item, e.g.
/// { key: "Calories", type: NUMBER, value: "540" } or
/// { key: "Sizes", type: LIST, value: "38,39,40,41,42" }.
model ItemAttribute {
  id       String        @id @default(cuid())
  key      String
  value    String
  type     AttributeType @default(TEXT)
  unit     String?
  position Int           @default(0)

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  @@index([itemId])
}

// ---------------------------------------------------------------------------
// QR Studio
// ---------------------------------------------------------------------------

model QrCode {
  id              String     @id @default(cuid())
  name            String
  targetUrl       String
  dotsColor       String     @default("#7C5CFF")
  backgroundColor String     @default("#0B0B14")
  dotsStyle       QrDotStyle @default(ROUNDED)
  cornerStyle     QrDotStyle @default(EXTRA_ROUNDED)
  logoUrl         String?
  scans           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  scanEvents ScanEvent[]

  @@index([companyId])
}

model ScanEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  locale    Locale   @default(en)
  device    String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  qrCode    QrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  qrCodeId  String?

  @@index([companyId, createdAt])
}

/// Anonymous product opens on the public catalog. Powers real "top items".
model ItemView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String

  @@index([companyId, itemId])
  @@index([companyId, createdAt])
}

/// Guest reports of prohibited catalogs. Stored for review and enforcement.
model AbuseReport {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  reason    AbuseReason
  details   String?     @db.VarChar(500)
  locale    Locale?
  /// SHA-256 of the reporter IP — used for rate limits, not shown publicly.
  ipHash    String?
  userAgent String?     @db.VarChar(300)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  @@index([companyId, createdAt])
  @@index([ipHash, createdAt])
}

/// Shared across serverless instances so the live "online now" count is real.
model PresencePing {
  visitorId String
  scope     String
  lastSeen  DateTime @updatedAt

  @@id([visitorId, scope])
  @@index([scope, lastSeen])
}
